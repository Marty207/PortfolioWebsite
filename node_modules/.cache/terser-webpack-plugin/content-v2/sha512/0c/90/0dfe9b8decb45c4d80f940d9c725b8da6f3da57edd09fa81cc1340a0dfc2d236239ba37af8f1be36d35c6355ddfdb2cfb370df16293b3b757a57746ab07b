,cACbxC,0BAAA,CAACyC,eAAK,CAACC,UAAU,EAAA3C,QAAA,cACfC,0BAAA,CAACsC,OAAG,GAAE,CAAC,CACS,CAAC,CACnBnD,QAAQ,CAACC,cAAc,CAAC,MAAM,CAChC,CAAC,C;;;;;;;ACVD,uC","file":"x","sourcesContent":["import React from \"react\";\n\nfunction Header() {\n  const goToTop = () => {\n    const section = document.getElementById(\"top\");\n    if (section) {\n      section.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  const goToProjects = () => {\n    const section = document.getElementById(\"projects\");\n    if (section) {\n      section.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  const goToContact = () => {\n    const section = document.getElementById(\"contact\");\n    if (section) {\n      section.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  const openGitHub = () => {\n    window.open(\"https://github.com/Marty207\", \"_blank\", \"noopener,noreferrer\");\n  };\n\n  const openLinkedIn = () => {\n    window.open(\n      \"https://www.linkedin.com/in/martin-donev-213377349/\",\n      \"_blank\",\n      \"noopener,noreferrer\"\n    );\n  };\n\n  return (\n    <header className=\"header\">\n      <button type=\"button\" className=\"header-logo-btn\" onClick={goToTop}>\n        Martin Donev\n      </button>\n\n      <nav>\n        <ul className=\"nav-links\">\n          <li>\n            <button type=\"button\" className=\"nav-btn\" onClick={goToProjects}>\n              Projects\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" className=\"nav-btn\" onClick={goToContact}>\n              Contact\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" className=\"nav-btn\" onClick={openGitHub}>\n              GitHub\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" className=\"nav-btn\" onClick={openLinkedIn}>\n              LinkedIn\n            </button>\n          </li>\n        </ul>\n      </nav>\n    </header>\n  );\n}\n\nexport default Header;","import React from \"react\";\n\nfunction Hero() {\n  const goToProjects = () => {\n    const section = document.getElementById(\"projects\");\n    if (section) {\n      section.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  const goToContact = () => {\n    const section = document.getElementById(\"contact\");\n    if (section) {\n      section.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  const openGitHub = () => {\n    window.open(\"https://github.com/Marty207\", \"_blank\", \"noopener,noreferrer\");\n  };\n\n  const openLinkedIn = () => {\n    window.open(\n      \"https://www.linkedin.com/in/martin-donev-213377349/\",\n      \"_blank\",\n      \"noopener,noreferrer\"\n    );\n  };\n\n  return (\n    <section id=\"top\" className=\"hero\">\n      <div className=\"hero-bg\">\n        <img src=\"/coding.gif\" alt=\"Coding background\" className=\"hero-bg-image\" />\n        <div className=\"hero-bg-overlay\"></div>\n      </div>\n\n      <div className=\"hero-content\">\n        <div className=\"hero-left\">\n          <p className=\"hero-tag\"></p>\n\n          <h1>Martin Donev</h1>\n\n          <h2>CS Undergraduate @ Illinois State University</h2>\n\n          <p className=\"hero-description\">\n          Backend-focused, with a strong interest in working with data and building real-world applications while integrating AI.\n          </p>\n\n          <div className=\"hero-buttons\">\n            <button type=\"button\" className=\"primary-btn\" onClick={goToProjects}>\n              View Projects\n            </button>\n\n            <button type=\"button\" className=\"secondary-btn\" onClick={goToContact}>\n              Contact\n            </button>\n          </div>\n\n          <div className=\"hero-socials\">\n            <button type=\"button\" className=\"hero-link-btn\" onClick={openGitHub}>\n              GitHub ↗\n            </button>\n\n            <button type=\"button\" className=\"hero-link-btn\" onClick={openLinkedIn}>\n              LinkedIn ↗\n            </button>\n          </div>\n        </div>\n\n        <div className=\"hero-right\">\n          <div className=\"hero-image-shell\">\n            <img\n              src=\"/martin-headshot.jpg\"\n              alt=\"Martin Donev\"\n              className=\"hero-image\"\n            />\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport default Hero;","import React, { useState } from \"react\";\n\nfunction Projects() {\n  const [activeProject, setActiveProject] = useState(null);\n  const [selectedImage, setSelectedImage] = useState(null);\n\n  const projects = [\n    {\n      id: 1,\n      title: \"Credit Card Recommendation System\",\n      shortDescription:\n        \"A recommendation platform built with filtering and ranking logic based on user preferences.\",\n      description:\n        \"A full-stack project that helps users find strong credit card matches using rule-based scoring, filtering, and backend decision logic.\",\n      previewImage: \"/CreditCardMain.png\",\n      video: \"/CreditCardVideo.mp4\",\n      images: [\"/CreditCardMain.png\", \"/CreditCardResults.png\"],\n      github: \"https://github.com/Marty207\",\n      live: \"\",\n      tech: [\"React\", \"Java\", \"REST API\"],\n    },\n    {\n      id: 2,\n      title: \"Tradernal\",\n      shortDescription:\n        \"A trading journal with analytics, performance tracking, and AI-style feedback.\",\n      description:\n        \"A personalized trading journal focused on reviewing trades, tracking progress, and improving consistency through data and AI-based features.\",\n      previewImage: \"/TradernalMain.png\",\n      video: \"/TradernalVideo.mp4\",\n      images: [\"/TradernalMain.png\", \"/TradernalDashboard.png\"],\n      github: \"https://github.com/Marty207\",\n      live: \"\",\n      tech: [\"React\", \"Flask\", \"Python\"],\n    },\n  ];\n\n  function openProject(project) {\n    setActiveProject(project);\n    setSelectedImage(null);\n  }\n\n  function closeProject() {\n    setActiveProject(null);\n    setSelectedImage(null);\n  }\n\n  return (\n    <section id=\"projects\" className=\"projects-section\">\n      <div className=\"section-heading\">\n        <p className=\"section-label\">Projects</p>\n        <h2>What I've Built</h2>\n      </div>\n\n      <div className=\"projects-grid\">\n        {projects.map((project) => (\n          <div key={project.id} className=\"project-card\">\n            <div className=\"project-card-image-wrap\">\n              <img\n                src={project.previewImage}\n                alt={project.title}\n                className=\"project-card-image\"\n              />\n            </div>\n\n            <div className=\"project-card-content\">\n              <h3>{project.title}</h3>\n              <p>{project.shortDescription}</p>\n\n              <div className=\"tech-list\">\n                {project.tech.map((item, index) => (\n                  <span key={index} className=\"tech-pill\">\n                    {item}\n                  </span>\n                ))}\n              </div>\n\n              <div className=\"project-actions\">\n                <button\n                  type=\"button\"\n                  className=\"project-btn\"\n                  onClick={() => openProject(project)}\n                >\n                  View Details\n                </button>\n\n                <a\n                  href={project.github}\n                  className=\"project-link-btn\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                >\n                  GitHub\n                </a>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {activeProject && (\n        <div className=\"modal-overlay\" onClick={closeProject}>\n          <div className=\"project-modal\" onClick={(e) => e.stopPropagation()}>\n            <button\n              type=\"button\"\n              className=\"close-btn\"\n              onClick={closeProject}\n              aria-label=\"Close project modal\"\n            >\n              ×\n            </button>\n\n            <h3>{activeProject.title}</h3>\n            <p className=\"modal-description\">{activeProject.description}</p>\n\n            <div className=\"modal-video-wrapper\">\n              <video\n                src={activeProject.video}\n                controls\n                className=\"modal-video\"\n              />\n            </div>\n\n            <div className=\"modal-top-links\">\n              {activeProject.live && (\n                <a\n                  href={activeProject.live}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"modal-link-btn\"\n                >\n                  Live Demo\n                </a>\n              )}\n\n              <a\n                href={activeProject.github}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"modal-link-btn\"\n              >\n                View GitHub\n              </a>\n            </div>\n\n            <h4 className=\"gallery-title\">Screenshots</h4>\n\n            <div className=\"modal-gallery\">\n              {activeProject.images.map((image, index) => (\n                <img\n                  key={index}\n                  src={image}\n                  alt={`${activeProject.title} screenshot ${index + 1}`}\n                  className=\"modal-gallery-image\"\n                  onClick={() => setSelectedImage(image)}\n                />\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {selectedImage && (\n        <div className=\"image-lightbox\" onClick={() => setSelectedImage(null)}>\n          <img\n            src={selectedImage}\n            alt=\"Expanded screenshot\"\n            className=\"lightbox-image\"\n          />\n        </div>\n      )}\n    </section>\n  );\n}\n\nexport default Projects;","import React from \"react\";\n\nfunction Contact() {\n  const openLinkedIn = () => {\n    window.open(\n      \"https://www.linkedin.com/in/martin-donev-213377349/\",\n      \"_blank\",\n      \"noopener,noreferrer\"\n    );\n  };\n\n  const openGitHub = () => {\n    window.open(\"https://github.com/Marty207\", \"_blank\", \"noopener,noreferrer\");\n  };\n\n  return (\n    <section id=\"contact\" className=\"contact\">\n      <div className=\"contact-big-card\">\n        <p className=\"contact-label\">Contact</p>\n\n        <h2 className=\"contact-title\">Let’s Connect</h2>\n\n        <p className=\"contact-info\"><strong>Email:</strong> donev.martin@yahoo.com</p>\n        <p className=\"contact-info\"><strong>Mobile:</strong> 224-535-0836</p>\n        <p className=\"contact-info\"><strong>Location:</strong> Chicago, IL</p>\n\n        <div className=\"contact-links\">\n          <a href=\"mailto:donev.martin@yahoo.com\" className=\"contact-main-btn\">\n            Email Me\n          </a>\n\n          <button\n            type=\"button\"\n            className=\"contact-secondary-btn\"\n            onClick={openLinkedIn}\n          >\n            LinkedIn\n          </button>\n\n          <button\n            type=\"button\"\n            className=\"contact-secondary-btn\"\n            onClick={openGitHub}\n          >\n            GitHub\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport default Contact;","import React from \"react\";\n\nfunction Footer() {\n  return (\n    <footer className=\"footer\">\n      <p>© 2026 Martin Donev. All rights reserved.</p>\n    </footer>\n  );\n}\n\nexport default Footer;","import React from \"react\";\nimport Header from \"./components/Header\";\nimport Hero from \"./components/Hero\";\nimport Projects from \"./components/Projects\";\nimport Contact from \"./components/Contact\";\nimport Footer from \"./components/Footer\";\nimport \"./styles/main.css\";\n\nfunction App() {\n  return (\n    <div className=\"App\">\n      <Header />\n      <Hero />\n      <Projects />\n      <Contact />\n      <Footer />\n    </div>\n  );\n}\n\nexport default App;","import React from \"react\";\nimport ReactDOM from \"react-dom\";\nimport App from \"./App\";\nimport \"./styles/main.css\";\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById(\"root\")\n);","// extracted by mini-css-extract-plugin"]}}